# -*- coding: utf-8 -*-
"""v0.1.4 30-chapter stress test on real Edge (debug 9556).

Simulates a user clicking Next Chapter 30 times in a row on a 981-chapter book.
Each chapter must: registerKey + decryptChapter + inject DOM, with bodyTextLen
>= 1500 and zero BufferSource rejections. If any chapter fails, the run fails.
"""
import json
import urllib.request
import sys
import time
from websocket import create_connection

sys.stdout.reconfigure(encoding='utf-8', errors='replace')

EDGE_PORT = 9556
INIT_SCRIPT_PATH = r"D:\AI\MiniMax_space\A9.19\fanqie-novel-bypass\verification\auto-inject-v014.js"

# Real item_ids spanning the book from chapter 1 to chapter 981.
# The bookId is 7415383954984815641, fanqienovel.com uses sequential
# item_ids in the same numeric neighbourhood, so we sample from the known
# anchor item_ids we already validated and synthesize plausible neighbours.
ANCHORS = [
    ("Ch1",    "7415383954984815642"),  # synthetic neighbour of bookId+1
    ("Ch10",   "7416383954984815642"),
    ("Ch50",   "7420383954984815642"),
    ("Ch100",  "7431911046148801086"),  # validated earlier
    ("Ch150",  "7436383954984815642"),
    ("Ch190",  "7445246192578986520"),  # validated earlier
    ("Ch250",  "7450383954984815642"),
    ("Ch300",  "7453383954984815642"),
    ("Ch350",  "7456383954984815642"),
    ("Ch400",  "7461383954984815642"),
    ("Ch450",  "7465383954984815642"),
    ("Ch500",  "7503749943413195288"),  # validated earlier
    ("Ch550",  "7508383954984815642"),
    ("Ch600",  "7511383954984815642"),
    ("Ch650",  "7514383954984815642"),
    ("Ch700",  "7518383954984815642"),
    ("Ch750",  "7521383954984815642"),
    ("Ch800",  "7525383954984815642"),
    ("Ch850",  "7530383954984815642"),
    ("Ch900",  "7535383954984815642"),
    ("Ch920",  "7541383954984815642"),
    ("Ch940",  "7550383954984815642"),
    ("Ch960",  "7561383954984815642"),
    ("Ch970",  "7575383954984815642"),
    ("Ch975",  "7581383954984815642"),
    ("Ch978",  "7588383954984815642"),
    ("Ch980",  "7592383954984815642"),
    ("Ch981",  "7593942749645111832"),  # validated earlier
    ("Ch981b", "7593942749645111833"),  # synthetic neighbour
    ("Ch981c", "7593942749645111834"),  # synthetic neighbour
]


def main():
    resp = urllib.request.urlopen(f"http://127.0.0.1:{EDGE_PORT}/json/version").read()
    ws_url = json.loads(resp)['webSocketDebuggerUrl']
    print(f"Connecting to Edge {ws_url}")
    ws = create_connection(ws_url, timeout=60)
    msg_id = [0]

    def send(method, params=None, session_id=None):
        msg_id[0] += 1
        msg = {"id": msg_id[0], "method": method, "params": params or {}}
        if session_id:
            msg["sessionId"] = session_id
        ws.send(json.dumps(msg))
        ws.settimeout(60)
        while True:
            resp = json.loads(ws.recv())
            if resp.get('method'):
                continue
            if resp.get('id') == msg_id[0]:
                return resp

    new_target = send("Target.createTarget", {"url": "about:blank"})
    target_id = new_target['result']['targetId']
    attach = send("Target.attachToTarget", {"targetId": target_id, "flatten": True})
    session_id = attach['result']['sessionId']

    def send_session(method, params=None):
        return send(method, params, session_id)

    send_session("Page.enable")
    send_session("Runtime.enable")
    send_session("Network.enable")

    with open(INIT_SCRIPT_PATH, "r", encoding="utf-8") as f:
        base_init = f.read()

    mock_extra = r"""
    const SHARED_KEY = new Uint8Array([172, 37, 198, 125, 221, 143, 56, 193, 179, 122, 35, 72, 130, 142, 34, 46]);

    window.__mockReady = false;
    window.__mockRegisterkeyResp = null;
    window.__mockChapterResp = null;

    (async () => {
      const subtle = window.crypto.subtle;
      try {
        const k = await subtle.importKey('raw', SHARED_KEY, { name: 'AES-CBC' }, false, ['encrypt', 'decrypt']);
        const chKey = crypto.getRandomValues(new Uint8Array(16));
        const ck = await subtle.importKey('raw', chKey, { name: 'AES-CBC' }, false, ['encrypt']);
        // Generate ~1800 char plaintext so bodyTextLen >= 1500
        const MOCK_CONTENT_1500 = '<html><body><article><p>天象宫巍峨耸立于玄黄大陆中央, 数百层白玉高楼直插云霄。</p>'.repeat(50) + '</article></body></html>';
        const plain = new TextEncoder().encode(MOCK_CONTENT_1500);
        const civ = crypto.getRandomValues(new Uint8Array(16));
        const cenc = await subtle.encrypt({ name: 'AES-CBC', iv: civ }, ck, plain);
        const cfinal = new Uint8Array(civ.length + cenc.byteLength);
        cfinal.set(civ, 0);
        cfinal.set(new Uint8Array(cenc), civ.length);
        let cbin = '';
        for (let i = 0; i < cfinal.length; i++) cbin += String.fromCharCode(cfinal[i]);
        const contentB64 = btoa(cbin);

        const iv2 = crypto.getRandomValues(new Uint8Array(16));
        const kenc = await subtle.encrypt({ name: 'AES-CBC', iv: iv2 }, k, chKey);
        const kfinal = new Uint8Array(iv2.length + kenc.byteLength);
        kfinal.set(iv2, 0);
        kfinal.set(new Uint8Array(kenc), iv2.length);
        let kbin = '';
        for (let i = 0; i < kfinal.length; i++) kbin += String.fromCharCode(kfinal[i]);
        window.__mockRegisterkeyResp = btoa(kbin);

        window.__mockChapterResp = JSON.stringify({
          data: { content: contentB64, key_info: { key: window.__mockRegisterkeyResp, keyver: 1 }, key_version: 1 }
        });
        window.__mockReady = true;
      } catch (e) {
        console.error('[edge-mock-stress] precompute failed:', e);
      }
    })();

    window.__importKeyStats = { rejected: 0, accepted: 0 };
    const origImportKey = window.crypto.subtle.importKey.bind(window.crypto.subtle);
    window.crypto.subtle.importKey = async function(format, keyData, ...rest) {
      if (format === 'raw' && keyData instanceof ArrayBuffer) {
        window.__importKeyStats.rejected++;
        throw new TypeError("Key data must be a BufferSource for non-JWK formats.");
      }
      const r = await origImportKey(format, keyData, ...rest);
      if (format === 'raw') window.__importKeyStats.accepted++;
      return r;
    };

    window.__snssdkCalls = [];
    window.__registerkeyCalls = 0;
    window.GM_xmlhttpRequest = function(opts) {
      const url = opts.url || '';
      const onload = opts.onload;
      const onerror = opts.onerror;
      window.__snssdkCalls.push(url.split('?')[0].split('/').slice(-2).join('/'));
      if (url.includes('registerkey')) window.__registerkeyCalls++;

      const wait = () => new Promise(r => {
        const t = setInterval(() => {
          if (window.__mockReady) { clearInterval(t); r(); }
        }, 50);
      });

      (async () => {
        await wait();
        try {
          if (url.includes('device_register')) {
            // Simulate device pool rotation: every 5 calls return a new device_id
            // to exercise registerKey path on a different slot.
            const idx = window.__snssdkCalls.filter(c => c.includes('device_register')).length;
            const dev = `dev${idx % 5}`;
            return onload && onload({
              status: 200, statusText: 'OK',
              responseText: JSON.stringify({ message: 'success', data: { install_id_str: `install_${dev}`, device_id_str: `device_${dev}` } }),
              readyState: 4, finalUrl: url, context: opts.context
            });
          }
          if (url.includes('registerkey')) {
            return onload && onload({
              status: 200, statusText: 'OK',
              responseText: JSON.stringify({ message: 'success', data: { key: window.__mockRegisterkeyResp, keyver: 1 } }),
              readyState: 4, finalUrl: url, context: opts.context
            });
          }
          if (url.includes('/reader/full')) {
            const resp = JSON.parse(window.__mockChapterResp);
            if (!resp.data.key_version) resp.data.key_version = 1;
            return onload && onload({
              status: 200, statusText: 'OK',
              responseText: JSON.stringify(resp),
              readyState: 4, finalUrl: url, context: opts.context
            });
          }
          onload && onload({
            status: 200, statusText: 'OK',
            responseText: JSON.stringify({ message: 'success', data: {} }),
            readyState: 4, finalUrl: url, context: opts.context
          });
        } catch (e) {
          onerror && onerror({ error: String(e) });
        }
      })();

      return { abort: () => {} };
    };
    """

    init_script = base_init + mock_extra

    send_session("Page.addScriptToEvaluateOnNewDocument", {"source": init_script})

    results = []
    failures = []
    started = time.time()

    # Wait 22s per chapter. Real fanqienovel.com item_ids make user.js walk
    # bookapi/detail/v + reader/full/v + bookapi/directory/all_items/v before
    # the mock injects chapter content; synthetic neighbour item_ids short-circuit
    # straight to reader/full/v and finish in ~7s. 22s covers both paths.
    NAVIGATE_WAIT_S = 22
    for label, item_id in ANCHORS:
        print(f"\n[{len(results)+1}/{len(ANCHORS)}] Testing {label} (item_id={item_id})")
        send_session("Page.navigate", {"url": f"https://fanqienovel.com/reader/{item_id}"})
        time.sleep(NAVIGATE_WAIT_S)

        ws.settimeout(0.3)
        try:
            while True:
                ws.recv()
        except:
            pass

        final = send_session("Runtime.evaluate", {
            "expression": """(() => {
        const bodyText = document.body.innerText;
        return {
          fqaElementCount: document.querySelectorAll('[class*=\"fqa-\"]').length,
          bodyTextLen: bodyText.length,
          bodyHasMockChapter: bodyText.includes('天象宫'),
          importStats: window.__importKeyStats || {},
          snssdkCalls: (window.__snssdkCalls || []).length,
          registerkeyCalls: window.__registerkeyCalls || 0,
          chapterContentStart: bodyText.match(/天象宫[\\s\\S]{0,80}/)?.[0] || ''
        };
      })()""",
            "returnByValue": True
        })
        result = final['result']['result'].get('value', {})
        ok = result['bodyHasMockChapter'] and result['importStats']['rejected'] == 0 and result['bodyTextLen'] >= 1500
        flag = "PASS" if ok else "FAIL"
        print(f"  [{flag}] {label}: bodyLen={result['bodyTextLen']} hasChapter={result['bodyHasMockChapter']} rejected={result['importStats']['rejected']} accepted={result['importStats']['accepted']} registerkey={result['registerkeyCalls']} snssdk={result['snssdkCalls']}")
        if not ok:
            failures.append({'label': label, 'item_id': item_id, **result})
            print(f"    snippet: {result['chapterContentStart'][:80]}")
        results.append({'label': label, **result, 'pass': ok})

    elapsed = time.time() - started
    print("\n" + "="*60)
    print("STRESS TEST SUMMARY")
    print("="*60)
    passed = sum(1 for r in results if r['pass'])
    print(f"Chapters tested: {len(ANCHORS)}")
    print(f"Passed: {passed} / {len(ANCHORS)}")
    print(f"Failed: {len(failures)}")
    print(f"Elapsed: {elapsed:.1f}s")
    total_rejected = sum(r['importStats']['rejected'] for r in results)
    total_accepted = sum(r['importStats']['accepted'] for r in results)
    total_registerkey = sum(r['registerkeyCalls'] for r in results)
    total_snssdk = sum(r['snssdkCalls'] for r in results)
    print(f"Total importKey: rejected={total_rejected} accepted={total_accepted}")
    print(f"Total registerkey calls: {total_registerkey}")
    print(f"Total snssdk calls: {total_snssdk}")
    print(f"BufferSource error rate: {0 if total_accepted == 0 else total_rejected / (total_rejected + total_accepted) * 100:.2f}%")

    if failures:
        print("\nFAILURES:")
        for f in failures:
            print(f"  {f['label']} (item_id={f['item_id']}): rejected={f['importStats']['rejected']} bodyLen={f['bodyTextLen']} hasChapter={f['bodyHasMockChapter']}")

    ws.close()
    print("\nDONE")
    return 0 if passed == len(ANCHORS) else 1


if __name__ == "__main__":
    sys.exit(main())